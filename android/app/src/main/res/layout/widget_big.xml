<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_cover" android:layout_width="88dp" android:layout_height="88dp"
            android:scaleType="centerCrop" android:src="@mipmap/ic_launcher" android:background="@drawable/widget_cover_bg"
            android:clipToOutline="true" android:contentDescription="Cover" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NOW PLAYING" android:textColor="#99FFFFFF"
                android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="MusicFlow Play" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"
                android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Tap to open" android:textColor="#B3FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageButton android:id="@+id/w_fav" android:layout_width="38dp" android:layout_height="38dp" android:background="@android:color/transparent" android:scaleType="centerInside"
            android:src="@drawable/ic_w_heart" android:contentDescription="Favorite" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/w_shuffle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:background="@android:color/transparent" android:scaleType="centerInside"
            android:src="@drawable/ic_shuffle_off" android:contentDescription="Shuffle" />
        <ImageButton android:id="@+id/w_prev" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:background="@android:color/transparent" android:scaleType="centerInside"
            android:src="@drawable/ic_w_prev" android:contentDescription="Previous" />
        <ImageButton android:id="@+id/w_play" android:layout_width="52dp" android:layout_height="52dp" android:padding="13dp"
            android:background="@drawable/widget_play_bg" android:scaleType="fitCenter" android:src="@drawable/ic_w_play" android:contentDescription="Play or pause" />
        <ImageButton android:id="@+id/w_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:background="@android:color/transparent" android:scaleType="centerInside"
            android:src="@drawable/ic_w_next" android:contentDescription="Next" />
        <ImageButton android:id="@+id/w_repeat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:background="@android:color/transparent" android:scaleType="centerInside"
            android:src="@drawable/ic_repeat_off" android:contentDescription="Repeat" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_upbox" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginTop="8dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UP NEXT" android:textColor="#99FFFFFF"
            android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" android:paddingBottom="2dp" />
        <TextView android:id="@+id/w_up1" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="" android:textColor="#E6FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_up2" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="" android:textColor="#E6FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_up3" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="" android:textColor="#E6FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:layout_marginTop="6dp">
        <LinearLayout android:id="@+id/w_sc_shuffle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_chip_bg"
            android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_shuffle_on" android:contentDescription="Shuffle" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shuffle" android:textColor="#FFFFFF"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_sc_fav" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_chip_bg"
            android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_w_heart_f" android:contentDescription="Favorites" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Favorites" android:textColor="#FFFFFF"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_sc_top" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_chip_bg"
            android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_w_chart" android:contentDescription="Most played" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Most played" android:textColor="#FFFFFF"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_sc_new" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_chip_bg"
            android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_w_new" android:contentDescription="Recently added" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recently added" android:textColor="#FFFFFF"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
