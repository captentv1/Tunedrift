<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp"
    android:background="@drawable/widget_bg">
        <LinearLayout android:id="@+id/w_sc_shuffle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_chip_bg"
            android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_shuffle_on" android:contentDescription="Shuffle" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shuffle" android:textColor="#FFFFFF"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_sc_fav" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_chip_bg"
            android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_w_heart_f" android:contentDescription="Favorites" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Favorites" android:textColor="#FFFFFF"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_sc_top" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_chip_bg"
            android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_w_chart" android:contentDescription="Most played" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Most played" android:textColor="#FFFFFF"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_sc_new" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_chip_bg"
            android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_w_new" android:contentDescription="Recently added" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recently added" android:textColor="#FFFFFF"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
        </LinearLayout>
</LinearLayout>
